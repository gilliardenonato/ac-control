{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true, "jsx": "react-jsx", "allowImportingTsExtensions": true,
    "types": ["node"], "lib": ["ES2023", "DOM"]
  },
  "include": ["apps/*/src", "packages/*/src", "packages/*/test", "packages/providers/*/src", "packages/providers/*/test", "spikes", "test"]
}
